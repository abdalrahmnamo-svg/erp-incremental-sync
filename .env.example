ERP_URL=http://localhost:8069
ERP_DB=demo
ERP_USER=demo
ERP_API_KEY=change-me
SYNC_PAGE_SIZE=50
# Lookback window (seconds) re-read on every run to catch late-committing / same-second edits
SYNC_OVERLAP_SECONDS=2
# Optional: where the target SQLite file lives (default ./output/sync.db)
SYNC_DB_PATH=./output/sync.db
